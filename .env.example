# ── Django ─────────────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ───────────────────────────────────────────────────
# sqlite (default, no setup) | postgres. docker-compose forces postgres.
DB_ENGINE=sqlite
# Used only when DB_ENGINE=postgres:
DB_NAME=agentforge
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ── Redis (Celery broker) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Ollama ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# ── ChromaDB ───────────────────────────────────────────────────
# For local dev (venv): leave CHROMA_MODE=local, no server needed.
# For Docker: set CHROMA_MODE=http (docker-compose sets this automatically).
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── RAG chunking (changing these requires /reindex/) ───────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_TOP_K=4
